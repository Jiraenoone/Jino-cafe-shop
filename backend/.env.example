# ─────────────────────────────────────────────────────────────
#  backend/.env.example
#  คัดลอกไฟล์นี้เป็น .env และใส่ค่าจริง
#  ห้าม commit .env ลง Git โดยเด็ดขาด!
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME="Jino Café API"
APP_ENV=development          # development | production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ── Database ──────────────────────────────────────────────────
# สำหรับ local dev ใช้ SQLite (ง่ายที่สุด ไม่ต้องติดตั้งอะไร)
# สำหรับ Azure SQL ให้เปลี่ยนเป็น mssql+aioodbc://...
DATABASE_URL=sqlite+aiosqlite:///./jinocafe_dev.db

# Azure SQL (uncomment เมื่อ deploy ไป Azure)
# DATABASE_URL=mssql+aioodbc://@<server>.database.windows.net/<dbname>?driver=ODBC+Driver+18+for+SQL+Server&authentication=ActiveDirectoryMsi

# ── Azure Service Bus ─────────────────────────────────────────
# ใส่ connection string หรือ namespace สำหรับ Managed Identity
SERVICEBUS_NAMESPACE=          # e.g. jinocafe.servicebus.windows.net
SERVICEBUS_QUEUE_NAME=order-created
# สำหรับ local dev (ใช้ connection string โดยตรง)
SERVICEBUS_CONNECTION_STRING=  # ใส่ถ้า Managed Identity ไม่พร้อม

# ── Azure Key Vault ───────────────────────────────────────────
KEY_VAULT_URL=                 # e.g. https://jinocafe-kv.vault.azure.net/

# ── Application Insights ─────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=  # ใส่เมื่อ deploy

# ── Admin Auth ────────────────────────────────────────────────
# API key สำหรับ admin endpoints (เก็บใน Key Vault บน production)
ADMIN_API_KEY=dev-admin-key-change-this-in-production
