# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.env
*.env
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
*.log

# Node (if any tooling is added later)
node_modules/
npm-debug.log*

# Azure
*.publishsettings
.azure/

# Database
*.db
*.sqlite
*.sqlite3

# Secrets (NEVER commit these)
*.pem
*.key
*.pfx
secrets/
